datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./zod"
  config   = "./zod-generator.config.json"
}

model User {
  id                       String                       @id @default(cuid())
  name                     String
  email                    String
  emailVerified            Boolean
  image                    String?
  username                 String?
  bio                      String?                      @db.Text
  businessEmail            String?
  socialLinks              Json?
  createdAt                DateTime
  updatedAt                DateTime
  role                     String?
  banned                   Boolean?
  banReason                String?
  banExpires               DateTime?
  onboardingComplete       Boolean                      @default(false)
  paymentsCustomerId       String?
  locale                   String?
  twoFactorEnabled         Boolean?
  lastActiveOrganizationId String?
  sessions                 Session[]
  accounts                 Account[]
  passkeys                 Passkey[]
  invitations              Invitation[]
  purchases                Purchase[]
  members                  Member[]
  twofactors               TwoFactor[]
  notifications            Notification[]
  notificationPreferences  UserNotificationPreference[]
  creatorProfile           CreatorProfile?
  creatorAccountReports    CreatorAccountReport[]

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  activeOrganizationId String?

  token     String
  createdAt DateTime
  updatedAt DateTime

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  idToken      String?   @db.Text
  expiresAt    DateTime?
  password     String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime?
  updatedAt DateTime?

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model TwoFactor {
  id          String  @id @default(cuid())
  secret      String
  backupCodes String
  verified    Boolean @default(false)
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Organization {
  id                 String       @id @default(cuid())
  name               String
  slug               String?
  logo               String?
  createdAt          DateTime
  metadata           String?
  paymentsCustomerId String?
  members            Member[]
  invitations        Invitation[]
  purchases          Purchase[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum PurchaseType {
  SUBSCRIPTION
  ONE_TIME
}

model Purchase {
  id             String        @id @default(cuid())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String?
  type           PurchaseType
  customerId     String
  subscriptionId String?       @unique
  priceId        String
  status         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([subscriptionId])
  @@map("purchase")
}

enum NotificationTarget {
  IN_APP
  EMAIL
}

enum NotificationType {
  WELCOME
  APP_UPDATE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  data      Json             @default("{}")
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@map("notification")
}

model UserNotificationPreference {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  target    NotificationTarget
  createdAt DateTime           @default(now())

  @@unique([userId, type, target])
  @@map("user_notification_preference")
}

enum PendingCreatorStatus {
  PENDING_PAYMENT
  PROCESSING
  COMPLETED
  EXPIRED
}

enum CreatorBidType {
  INITIAL
  INCREASE
}

enum CreatorBidStatus {
  PENDING
  PAID
  FAILED
}

enum CreatorPaymentSource {
  MOCK
  STRIPE
}

enum CreatorAnalyticsEventType {
  PROFILE_VIEW
  SOCIAL_CLICK
  CONTACT_CLICK
}

enum CreatorReportReason {
  ADULT_CONTENT
  DRUG_RELATED
  ILLEGAL
  FAKE_OR_IMPERSONATION
  OTHER
}

enum CreatorReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

enum CreatorGender {
  MAN
  WOMAN
  PREFER_NOT_TO_SAY
}

model CreatorCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  icon        String?
  color       String?
  active      Boolean @default(true)
  order       Int     @default(0)

  creators        CreatorProfile[]
  pendingCreators PendingCreator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
  @@map("creator_category")
}

model CreatorProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  publicName  String
  avatarUrl   String
  description String? @db.Text

  categoryId String
  category   CreatorCategory @relation(fields: [categoryId], references: [id])

  totalBidCents Int    @default(0)
  currency      String @default("USD")

  joinedAt         DateTime
  bidReachedAt     DateTime
  accountClaimedAt DateTime?

  /// ISO 3166-1 alpha-2 country code (e.g. FR, MA, US)
  countryCode String?
  gender      CreatorGender?
  /// ISO 639-1 language codes as JSON array (e.g. ["fr","en"])
  languages   Json?

  isPublished Boolean @default(false)

  socialProfiles  SocialProfile[]
  bids            CreatorBid[]
  analyticsEvents CreatorAnalyticsEvent[]
  accountReports  CreatorAccountReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([totalBidCents, bidReachedAt])
  @@index([categoryId, totalBidCents, bidReachedAt])
  @@index([isPublished, totalBidCents])
  @@index([categoryId, isPublished, totalBidCents])
  @@map("creator_profile")
}

model SocialProfile {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  platform      String
  url           String
  normalizedUrl String
  position      Int

  deletedAt DateTime?

  analyticsEvents CreatorAnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorId, position])
  @@index([creatorId, deletedAt])
  @@index([normalizedUrl])
  @@index([creatorId, position])
  @@map("social_profile")
}

model PendingCreator {
  id String @id @default(cuid())

  email       String
  publicName  String
  avatarUrl   String
  description String? @db.Text

  categoryId String
  category   CreatorCategory @relation(fields: [categoryId], references: [id])

  socialProfiles Json

  /// ISO 3166-1 alpha-2 country code collected at signup Step 2
  countryCode String?

  bidAmountCents Int
  currency       String @default("USD")

  estimatedRank Int?

  status PendingCreatorStatus @default(PENDING_PAYMENT)

  paymentReference String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([email])
  @@index([status, expiresAt])
  @@index([categoryId])
  @@map("pending_creator")
}

model CreatorBid {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  type   CreatorBidType
  status CreatorBidStatus

  amountCents Int
  currency    String @default("USD")

  totalAfterCents Int?

  paymentSource CreatorPaymentSource

  providerPaymentId String? @unique
  idempotencyKey    String  @unique

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([creatorId, createdAt])
  @@index([creatorId, status, createdAt])
  @@index([status, createdAt])
  @@map("creator_bid")
}

model CreatorAnalyticsEvent {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  type CreatorAnalyticsEventType

  socialProfileId String?
  socialProfile   SocialProfile? @relation(fields: [socialProfileId], references: [id], onDelete: SetNull)

  platformSnapshot String?
  urlSnapshot      String?

  visitorKeyHash String?

  createdAt DateTime @default(now())

  @@index([creatorId, createdAt])
  @@index([creatorId, type, createdAt])
  @@index([socialProfileId, createdAt])
  @@index([creatorId, type, visitorKeyHash, createdAt])
  @@map("creator_analytics_event")
}

model CreatorAccountReport {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  reporterUserId String?
  reporterUser   User?   @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)

  /// Guest reporter name when not signed in
  reporterName  String?
  /// Guest reporter email when not signed in
  reporterEmail String?

  reason  CreatorReportReason
  message String              @db.Text

  status CreatorReportStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId, createdAt])
  @@index([status, createdAt])
  @@index([reporterUserId, createdAt])
  @@map("creator_account_report")
}
