# Production environment template for VPS deployment.
# Copy to /opt/influbid/.env and fill in real values (never commit .env).

# --- Domains & TLS ---
DOMAIN_MARKETING=example.com
DOMAIN_SAAS=app.example.com
ACME_EMAIL=admin@example.com

# --- GitHub Container Registry (pull on VPS) ---
# GHCR_OWNER=iamreda
# Used by docker compose pull; login separately with GHCR_TOKEN.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=supastarter
DATABASE_URL=postgresql://postgres:change-me-strong-password@postgres:5432/supastarter

# --- Auth ---
BETTER_AUTH_SECRET=change-me-random-secret-at-least-32-chars

# --- Public app URLs (must match DOMAIN_* above) ---
NEXT_PUBLIC_SAAS_URL=https://app.example.com
NEXT_PUBLIC_MARKETING_URL=https://example.com

# --- MinIO (S3-compatible storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me-minio-password
NEXT_PUBLIC_AVATARS_BUCKET_NAME=avatars

# --- Mail (Resend) ---
MAIL_FROM=noreply@example.com
RESEND_API_KEY=

# --- Stripe payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_ID_PRO_MONTHLY=
PRICE_ID_PRO_YEARLY=
PRICE_ID_LIFETIME=

# Never enable in production:
# MOCK_PAYMENTS=true
