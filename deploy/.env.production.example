# Secret GitHub : PRODUCTION_ENV
# Settings → Secrets and variables → Actions → New repository secret
#
# Nom du secret  : PRODUCTION_ENV          ← lettres et underscores uniquement
# Valeur du secret : le bloc ci-dessous     ← vos vraies valeurs (multiligne)
#
# Ne créez PAS un secret nommé "postgresql://..." — c'est la VALEUR, pas le nom.
#
# Secrets séparés (déjà configurés) :
#   VPS_HOST, VPS_USER, VPS_SSH_PRIVATE_KEY, VPS_SSH_PORT, DEPLOY_PATH, GHCR_TOKEN
#   NEXT_PUBLIC_SAAS_URL, NEXT_PUBLIC_MARKETING_URL
#
# DATABASE_URL est généré automatiquement à partir de POSTGRES_PASSWORD.

DOMAIN_MARKETING=example.com
DOMAIN_SAAS=app.example.com
ACME_EMAIL=admin@example.com

POSTGRES_PASSWORD=change-me-strong-password

BETTER_AUTH_SECRET=change-me-random-secret-at-least-32-chars

MINIO_ROOT_PASSWORD=change-me-minio-password

MAIL_FROM=noreply@example.com
RESEND_API_KEY=re_xxxxxxxx

STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
PRICE_ID_PRO_MONTHLY=price_xxxxxxxx
PRICE_ID_PRO_YEARLY=price_xxxxxxxx
PRICE_ID_LIFETIME=price_xxxxxxxx
